{
	"name": "windshift-e2e",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"test": "playwright test",
		"test:headed": "playwright test --headed",
		"test:debug": "playwright test --debug",
		"test:ui": "playwright test --ui",
		"test:report": "playwright show-report",
		"test:suite-boundaries": "node scripts/check-suite-boundaries.mjs",
		"test:result-policy": "node --test helpers/result-policy-reporter.test.mjs",
		"test:selector-policy": "node --test helpers/selector-policy.test.mjs && node scripts/check-stable-selectors.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@playwright/test": "^1.49.0",
		"typescript": "^5.7.0"
	}
}
